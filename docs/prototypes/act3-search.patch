+// SCRATCH (search experiments; not for the main tree). Measures forks and
+// rollouts in the midgame, evaluates candidate plans by rolling each out
+// with a copy of the live policy, and optionally acts on the best one.
+// Everything it logs is one `PROBE {json}` line per probe.
+import { Game, Player, PlayerType } from "../../../core/game/Game";
+import { IntentSchema } from "../../../core/Schemas";
+import { AgentContext, AgentIntent } from "../../Agent";
+import { GameFork } from "../../Fork";
+import { MAX_INTENT_BYTES } from "../../IntentBudget";
+import { BudgetMirror, RolloutPolicy, SimView } from "../../lib/Lookahead";
+import { HomeFloors, Prio, Proposal } from "../../lib/Scheduler";
+import { WorldModel } from "../../lib/WorldModel";
+import type { ApexOptions } from "./options";
+
+export interface DirectiveStep {
+  /** Ticks after the probe tick (0 = this tick's run). */
+  delay: number;
+  p?: Proposal;
+  /** Attack troops as this share of purse.available("strike") when sent. */
+  frac?: number;
+  /** Mark a foe (no alliance with it) until a tick, when applied. */
+  foe?: { id: string; until: number };
+}
+
+export interface RolloutSpec {
+  directive: DirectiveStep[];
+  /** Decision cadence shift of the copy (s.timers.lastThink -= shift). */
+  shift: number;
+  /** Options override for the copy. */
+  o?: Partial<ApexOptions>;
+}
+
+export interface ProbeHost {
+  floors(): HomeFloors;
+  wm(): WorldModel | null;
+  inStall(tick: number): boolean;
+  forRolloutWith(spec: RolloutSpec, tick: number): RolloutPolicy;
+  setDirective(steps: DirectiveStep[], tick: number): void;
+}
+
+interface Snap {
+  h: number;
+  tiles: number;
+  home: number;
+  out: number;
+  inc: number;
+  cap: number;
+  gold: number;
+  alive: boolean;
+  natAtks: number;
+  natTroops: number;
+  rank: number;
+  top: number;
+}
+
+interface Cand {
+  name: string;
+  spec: RolloutSpec;
+  /** act3: ticks after the fork when the plan's strike is sent. */
+  strikeAt?: number;
+}
+
+function isValidIntent(intent: AgentIntent): boolean {
+  return (
+    IntentSchema.safeParse(intent).success &&
+    JSON.stringify(intent).length <= MAX_INTENT_BYTES
+  );
+}
+
+function rankOf(game: Game, me: Player): { rank: number; top: number } {
+  let rank = 1;
+  let top = 0;
+  const mine = me.numTilesOwned();
+  for (const p of game.players()) {
+    if (p === me || p.type() === PlayerType.Bot || !p.isAlive()) continue;
+    const n = p.numTilesOwned();
+    if (n > mine) rank++;
+    if (n > top) top = n;
+  }
+  return { rank, top };
+}
+
+function snapOf(
+  game: Game,
+  me: Player,
+  h: number,
+  natAtks: number,
+  natTroops: number,
+): Snap {
+  let out = 0;
+  for (const a of me.outgoingAttacks()) out += a.troops();
+  let inc = 0;
+  for (const a of me.incomingAttacks()) {
+    if (a.attacker().type() !== PlayerType.Bot) inc += a.troops();
+  }
+  const { rank, top } = rankOf(game, me);
+  return {
+    h,
+    tiles: me.numTilesOwned(),
+    home: Math.round(me.troops()),
+    out: Math.round(out),
+    inc: Math.round(inc),
+    cap: Math.round(game.config().maxTroops(me)),
+    gold: Number(me.gold()),
+    alive: me.isAlive(),
+    natAtks,
+    natTroops: Math.round(natTroops),
+    rank,
+    top,
+  };
+}
+
+/** Steps `f` `ticks` times with `policy` (null: no intents), sampling at
+ *  every checkpoint in `at`. Times the policy and the simulation apart. */
+function roll(
+  ctx: AgentContext,
+  f: GameFork,
+  policy: RolloutPolicy | null,
+  ticks: number,
+  at: readonly number[],
+  trace?: Map<number, string[]>,
+): { snaps: Snap[]; simMs: number; polMs: number; chunkMs: number[] } {
+  const me = f.game.playerByClientID(ctx.clientID);
+  if (me === null) throw new Error("probe: no player in fork");
+  const budget = BudgetMirror.fromLive(
+    ctx.budget(),
+    ctx.tick * ctx.game.config().msPerTick(),
+  );
+  const snaps: Snap[] = [];
+  const seen = new Set<string>();
+  let natAtks = 0;
+  let natTroops = 0;
+  let simMs = 0;
+  let polMs = 0;
+  const chunkMs: number[] = [];
+  let chunkStart = performance.now();
+  const want = new Set(at);
+  for (let h = 1; h <= ticks; h++) {
+    let intents: AgentIntent[] = [];
+    if (policy !== null) {
+      const g = f.game;
+      const view: SimView = {
+        game: g,
+        me,
+        tick: g.ticks(),
+        gameID: ctx.gameID,
+        budget,
+      };
+      const p0 = performance.now();
+      intents = policy.step(view).filter(isValidIntent);
+      polMs += performance.now() - p0;
+      if (trace !== undefined && h <= 80 && intents.length > 0) {
+        trace.set(view.tick, intents.map((i) => JSON.stringify(i)));
+      }
+    }
+    const s0 = performance.now();
+    f.step(intents);
+    simMs += performance.now() - s0;
+    for (const a of me.incomingAttacks()) {
+      const t = a.attacker().type();
+      if (t === PlayerType.Bot || seen.has(a.id())) continue;
+      seen.add(a.id());
+      natAtks++;
+      natTroops += a.troops();
+    }
+    if (h % 100 === 0) {
+      const now = performance.now();
+      chunkMs.push(Math.round((now - chunkStart) * 10) / 10);
+      chunkStart = now;
+    }
+    if (want.has(h)) snaps.push(snapOf(f.game, me, h, natAtks, natTroops));
+    if (me.hasSpawned() && !me.isAlive()) {
+      snaps.push(snapOf(f.game, me, h, natAtks, natTroops));
+      break;
+    }
+  }
+  return { snaps, simMs, polMs, chunkMs };
+}
+
+/** A resumable rollout: one fork and one policy copy, stepped on demand. */
+class Runner {
+  readonly me: Player;
+  private readonly budget: BudgetMirror;
+  private readonly seen = new Set<string>();
+  natAtks = 0;
+  natTroops = 0;
+  h = 0;
+  simMs = 0;
+  polMs = 0;
+  dead = false;
+  snaps: Snap[] = [];
+  /** Nations (and humans) whose attacks reached us: first h and troops. */
+  attackers = new Map<string, { h: number; troops: number }>();
+
+  constructor(
+    private readonly ctx: AgentContext,
+    readonly f: GameFork,
+    private readonly policy: RolloutPolicy,
+    readonly name: string,
+    readonly forkMs: number,
+  ) {
+    const me = f.game.playerByClientID(ctx.clientID);
+    if (me === null) throw new Error("probe: no player in fork");
+    this.me = me;
+    this.budget = BudgetMirror.fromLive(
+      ctx.budget(),
+      ctx.tick * ctx.game.config().msPerTick(),
+    );
+  }
+
+  /** Steps to horizon `to`, snapping at the checkpoints in `at`. */
+  advance(to: number, at: readonly number[]): Snap {
+    const want = new Set(at);
+    while (this.h < to && !this.dead) {
+      const g = this.f.game;
+      const view: SimView = {
+        game: g,
+        me: this.me,
+        tick: g.ticks(),
+        gameID: this.ctx.gameID,
+        budget: this.budget,
+      };
+      const p0 = performance.now();
+      const intents = this.policy.step(view).filter(isValidIntent);
+      const s0 = performance.now();
+      this.polMs += s0 - p0;
+      this.f.step(intents);
+      this.simMs += performance.now() - s0;
+      this.h++;
+      for (const a of this.me.incomingAttacks()) {
+        if (a.attacker().type() === PlayerType.Bot || this.seen.has(a.id())) {
+          continue;
+        }
+        this.seen.add(a.id());
+        this.natAtks++;
+        this.natTroops += a.troops();
+        const id = a.attacker().id();
+        const prev = this.attackers.get(id);
+        if (prev === undefined) {
+          this.attackers.set(id, { h: this.h, troops: a.troops() });
+        } else prev.troops += a.troops();
+      }
+      if (this.me.hasSpawned() && !this.me.isAlive()) this.dead = true;
+      if (want.has(this.h) || this.dead) {
+        this.snaps.push(
+          snapOf(g, this.me, this.h, this.natAtks, this.natTroops),
+        );
+      }
+    }
+    const last = this.snaps[this.snaps.length - 1];
+    if (last !== undefined && last.h === this.h) return last;
+    const s = snapOf(this.f.game, this.me, this.h, this.natAtks, this.natTroops);
+    this.snaps.push(s);
+    return s;
+  }
+}
+
+/** V = tiles + beta·(home + out)/cbar − alpha·inc/cbar; dead: −Infinity. */
+function valueOf(s: Snap, o: ApexOptions): number {
+  if (!s.alive) return -Infinity;
+  return (
+    s.tiles + (o.probeBeta * (s.home + s.out)) / o.probeCbar -
+    (o.probeAlpha * s.inc) / o.probeCbar
+  );
+}
+
+/** The bordering nations at a probe (logs only). */
+function neighbours(ctx: AgentContext, wm: WorldModel | null): unknown[] {
+  if (wm === null) return [];
+  const out: unknown[] = [];
+  for (const n of wm.nations) {
+    if (n.type !== PlayerType.Nation || !ctx.game.hasPlayer(n.id)) continue;
+    const N = ctx.game.player(n.id);
+    if (!N.isAlive()) continue;
+    const al = ctx.me.allianceWith(N);
+    out.push({
+      id: n.id,
+      name: N.name(),
+      T: Math.round(N.troops()),
+      M: Math.round(ctx.game.config().maxTroops(N)),
+      tiles: N.numTilesOwned(),
+      contact: n.contact,
+      ally: al === null ? null : al.expiresAt() - ctx.tick,
+    });
+  }
+  return out;
+}
+
+export class SearchProbe {
+  private done = new Set<number>();
+  private checks: { tick: number; h: number; pred: Snap; t0: number }[] = [];
+  trace: Map<number, string[]> | null = null;
+  traceFrom = 0;
+  liveTrace = new Map<number, string[]>();
+
+  /** Live sends of tick t (for the trace comparison). */
+  noteLive(t: number, intents: AgentIntent[]): void {
+    if (this.trace === null) return;
+    if (t < this.traceFrom || t > this.traceFrom + 80) {
+      if (t > this.traceFrom + 80) this.compare(t);
+      return;
+    }
+    if (intents.length > 0) {
+      this.liveTrace.set(t, intents.map((i) => JSON.stringify(i)));
+    }
+  }
+
+  private lastCtx: AgentContext | null = null;
+
+  private compare(t: number): void {
+    const tr = this.trace;
+    if (tr === null || this.lastCtx === null) return;
+    const ticks = new Set([...tr.keys(), ...this.liveTrace.keys()]);
+    const diffs: string[] = [];
+    for (const k of [...ticks].sort((a, b) => a - b)) {
+      const a = (tr.get(k) ?? []).join(" | ");
+      const b = (this.liveTrace.get(k) ?? []).join(" | ");
+      if (a !== b) diffs.push(`${k}: roll=[${a}] live=[${b}]`);
+    }
+    this.lastCtx.log(
+      `PROBE_TRACE from ${this.traceFrom} diffs=${diffs.length} ` +
+        diffs.slice(0, 6).join(" ;; ").slice(0, 3000),
+    );
+    this.trace = null;
+    this.liveTrace = new Map();
+    void t;
+  }
+
+  constructor(private readonly o: ApexOptions) {}
+
+  private due(tick: number): boolean {
+    const o = this.o;
+    if (o.probeTicks.includes(tick)) return true;
+    if (o.probeEvery > 0 && tick >= o.probeFrom) {
+      return (tick - o.probeFrom) % o.probeEvery === 0;
+    }
+    return false;
+  }
+
+  /** Called at the start of the live tick, before any send. */
+  private lastWall: number | null = null;
+  private probeWall = 0;
+  private intervals: number[] = [];
+
+  /** Mean wall ms per live tick over the last 200 ticks (probes excluded):
+   *  the live simulation plus every agent's think, at the current load. */
+  liveMsPerTick(): number {
+    if (this.intervals.length === 0) return 0;
+    let sum = 0;
+    for (const x of this.intervals) sum += x;
+    return Math.round((sum / this.intervals.length) * 100) / 100;
+  }
+
+  tick(ctx: AgentContext, host: ProbeHost): void {
+    const now = performance.now();
+    if (this.lastWall !== null) {
+      this.intervals.push(now - this.lastWall - this.probeWall);
+      if (this.intervals.length > 200) this.intervals.shift();
+    }
+    this.probeWall = 0;
+    this.lastWall = now;
+    this.lastCtx = ctx;
+    this.verify(ctx);
+    const o = this.o;
+    if (o.probeMode === "") return;
+    const t = ctx.tick;
+    if (ctx.game.inSpawnPhase() || !ctx.me.isAlive()) return;
+    if (!this.due(t) || this.done.has(t)) return;
+    this.done.add(t);
+    if (o.probeStallOnly && !host.inStall(t)) return;
+    const p0 = performance.now();
+    try {
+      if (o.probeMode === "cost") this.cost(ctx, host);
+      else if (o.probeMode === "act2") this.act2(ctx, host);
+      else if (o.probeMode === "act3") this.act3(ctx, host);
+      else this.plans(ctx, host, o.probeMode === "act");
+    } catch (e) {
+      ctx.log(`PROBE error ${String(e)}`);
+    }
+    this.probeWall = performance.now() - p0;
+  }
+
+  /** Live values at the checkpoints of the base rollouts (log-only mode):
+   *  how exact the base prediction is. */
+  private verify(ctx: AgentContext): void {
+    if (this.checks.length === 0) return;
+    const keep: typeof this.checks = [];
+    for (const c of this.checks) {
+      if (ctx.tick !== c.tick) {
+        if (ctx.tick < c.tick) keep.push(c);
+        continue;
+      }
+      const me = ctx.me;
+      const live = snapOf(ctx.game, me, c.h, 0, 0);
+      ctx.log(
+        `PROBE_CHECK ${JSON.stringify({
+          t0: c.t0,
+          h: c.h,
+          pred: { tiles: c.pred.tiles, home: c.pred.home, out: c.pred.out },
+          live: { tiles: live.tiles, home: live.home, out: live.out },
+        })}`,
+      );
+    }
+    this.checks = keep;
+  }
+
+  private checkpoints(): number[] {
+    const H = this.o.probeH;
+    const at = [50, 100, 150, 200, 300, 450, 600, 900, 1200, 1800, 2400];
+    return [...at.filter((h) => h < H), H];
+  }
+
+  private cost(ctx: AgentContext, host: ProbeHost): void {
+    const H = this.o.probeH;
+    const at = this.checkpoints();
+    const f0 = performance.now();
+    const f1 = ctx.fork();
+    const fork1 = performance.now() - f0;
+    const split = (ctx as unknown as { forkSplit?: () => unknown }).forkSplit?.();
+    const nul = roll(ctx, f1, null, H, at);
+    const f2s = performance.now();
+    const f2 = ctx.fork();
+    const fork2 = performance.now() - f2s;
+    const pol = host.forRolloutWith({ directive: [], shift: 0 }, ctx.tick);
+    this.trace = new Map();
+    this.traceFrom = ctx.tick;
+    const withPol = roll(ctx, f2, pol, H, at, this.trace);
+    const cl = (pol as { copyLog?: () => string[] }).copyLog?.() ?? [];
+    ctx.log(
+      `PROBE_COPYLOG ${cl.filter((l) => l.includes("boat")).join(" || ").slice(0, 6000)}`,
+    );
+    const me = ctx.me;
+    ctx.log(
+      `PROBE ${JSON.stringify({
+        mode: "cost",
+        t: ctx.tick,
+        liveMsPerTick: this.liveMsPerTick(),
+        tiles: me.numTilesOwned(),
+        players: ctx.game.players().filter((p) => p.isAlive()).length,
+        fork1: Math.round(fork1),
+        split,
+        fork2: Math.round(fork2),
+        nullSim: Math.round(nul.simMs),
+        nullChunks: nul.chunkMs,
+        polSim: Math.round(withPol.simMs),
+        polPol: Math.round(withPol.polMs),
+        polChunks: withPol.chunkMs,
+        base: withPol.snaps,
+        nul: nul.snaps,
+      })}`,
+    );
+    for (const s of withPol.snaps) {
+      this.checks.push({ tick: ctx.tick + s.h, h: s.h, pred: s, t0: ctx.tick });
+    }
+  }
+
+  private candidates(ctx: AgentContext, host: ProbeHost): Cand[] {
+    const o = this.o;
+    const kinds = new Set(o.probeKinds.split(","));
+    const out: Cand[] = [{ name: "base", spec: { directive: [], shift: 0 } }];
+    if (kinds.has("shift")) {
+      for (let k = 1; k <= o.probeShifts; k++) {
+        out.push({ name: `shift${k}`, spec: { directive: [], shift: k } });
+      }
+    }
+    if (kinds.has("hold")) {
+      out.push({
+        name: "hold",
+        spec: {
+          directive: [],
+          shift: 0,
+          o: {
+            strikes: false,
+            stallStrike: false,
+            stallTribes: false,
+            stallBoats: false,
+          },
+        },
+      });
+    }
+    const wm = host.wm();
+    if (wm === null) return out;
+    const floors = host.floors();
+    const me = ctx.me;
+    const home = Math.min(me.troops(), Math.ceil(floors.cap));
+    const avail = Math.max(0, home - floors.strike);
+    const nations = wm.nations
+      .filter((n) => n.type === PlayerType.Nation && n.contact >= 8)
+      .filter((n) => ctx.game.hasPlayer(n.id))
+      .sort((a, b) => b.contact - a.contact);
+    let k = 0;
+    for (const n of nations) {
+      if (k >= o.probeK) break;
+      const N = ctx.game.player(n.id);
+      if (!N.isAlive()) continue;
+      const friendly = me.isFriendly(N);
+      const mk = (S: number, delay: number): DirectiveStep => ({
+        delay,
+        p: {
+          intent: { type: "attack", targetID: n.id, troops: Math.floor(S) },
+          prio: Prio.Strike,
+          cls: "strike",
+          key: `attack:${n.smallID}`,
+          spend: { kind: "strike", troops: Math.floor(S) },
+          plan: "strike",
+          meta: { target: n.smallID, clampTroops: S, expectedRefund: 0 },
+        },
+      });
+      if (!friendly) {
+        if (!n.attackable || avail < 1000) continue;
+        k++;
+        if (kinds.has("strike")) {
+          out.push({
+            name: `strike:${n.id}:full`,
+            spec: { directive: [mk(avail, 0)], shift: 0 },
+          });
+        }
+        if (kinds.has("half")) {
+          out.push({
+            name: `strike:${n.id}:half`,
+            spec: { directive: [mk(avail / 2, 0)], shift: 0 },
+          });
+        }
+      } else if (kinds.has("break")) {
+        k++;
+        out.push({
+          name: `break:${n.id}:full`,
+          spec: {
+            directive: [
+              {
+                delay: 0,
+                p: {
+                  intent: { type: "breakAlliance", recipient: n.id },
+                  prio: Prio.Diplomacy,
+                  cls: "diplomacy",
+                  key: `break:${n.id}`,
+                },
+              },
+              mk(avail, 1),
+            ],
+            shift: 0,
+          },
+        });
+      }
+    }
+    return out;
+  }
+
+  private plans(ctx: AgentContext, host: ProbeHost, act: boolean): void {
+    const o = this.o;
+    const H = o.probeH;
+    const at = this.checkpoints();
+    const cands = this.candidates(ctx, host);
+    const rows: {
+      name: string;
+      forkMs: number;
+      simMs: number;
+      polMs: number;
+      snaps: Snap[];
+      v: number;
+    }[] = [];
+    const t0 = performance.now();
+    for (const c of cands) {
+      const fs = performance.now();
+      const f = ctx.fork();
+      const forkMs = performance.now() - fs;
+      const pol = host.forRolloutWith(c.spec, ctx.tick);
+      const r = roll(ctx, f, pol, H, at);
+      const last = r.snaps[r.snaps.length - 1];
+      rows.push({
+        name: c.name,
+        forkMs: Math.round(forkMs),
+        simMs: Math.round(r.simMs),
+        polMs: Math.round(r.polMs),
+        snaps: r.snaps,
+        v: last === undefined ? -Infinity : valueOf(last, o),
+      });
+    }
+    const totalMs = performance.now() - t0;
+    const base = rows[0];
+    let best = base;
+    for (const r of rows) {
+      if (r.name.startsWith("shift")) continue;
+      if (r.v > best.v) best = r;
+    }
+    let chosen = "base";
+    if (act && best !== base && best.v > base.v + o.probeMargin) {
+      const c = cands.find((x) => x.name === best.name);
+      if (c !== undefined) {
+        host.setDirective(c.spec.directive, ctx.tick);
+        chosen = best.name;
+      }
+    }
+    const floors = host.floors();
+    ctx.log(
+      `PROBE ${JSON.stringify({
+        mode: act ? "act" : "plans",
+        t: ctx.tick,
+        nbrs: neighbours(ctx, host.wm()),
+        liveMsPerTick: this.liveMsPerTick(),
+        tiles: ctx.me.numTilesOwned(),
+        home: Math.round(ctx.me.troops()),
+        cap: Math.round(floors.cap),
+        H: Math.round(floors.H),
+        stall: host.inStall(ctx.tick),
+        totalMs: Math.round(totalMs),
+        chosen,
+        rows,
+      })}`,
+    );
+    if (!act || chosen === "base") {
+      for (const s of base.snaps) {
+        this.checks.push({
+          tick: ctx.tick + s.h,
+          h: s.h,
+          pred: s,
+          t0: ctx.tick,
+        });
+      }
+    }
+  }
+
+  /** An attack proposal whose troops the directive sets (frac). */
+  private attackStep(id: string, sid: number, delay: number, frac: number) {
+    return {
+      delay,
+      frac,
+      p: {
+        intent: { type: "attack" as const, targetID: id, troops: 1 },
+        prio: Prio.Strike,
+        cls: "strike" as const,
+        key: `attack:${sid}`,
+        spend: { kind: "strike" as const, troops: 1 },
+        plan: "strike" as const,
+        meta: { target: sid, clampTroops: 1, expectedRefund: 0 },
+      },
+    };
+  }
+
+  /** act2's candidates, given who attacks us in the base rollout. */
+  private candidates2(
+    ctx: AgentContext,
+    host: ProbeHost,
+    attackers: ReadonlyMap<string, { h: number; troops: number }>,
+  ): Cand[] {
+    const o = this.o;
+    const kinds = new Set(o.probeKinds.split(","));
+    const out: Cand[] = [];
+    const wm = host.wm();
+    if (wm === null) return out;
+    const me = ctx.me;
+    const t = ctx.tick;
+    const nations = wm.nations
+      .filter((n) => n.type === PlayerType.Nation && ctx.game.hasPlayer(n.id))
+      .filter((n) => n.contact >= 8 || attackers.has(n.id))
+      .sort((a, b) => b.contact - a.contact);
+    let k = 0;
+    for (const n of nations) {
+      if (k >= o.probeK) break;
+      const N = ctx.game.player(n.id);
+      if (!N.isAlive()) continue;
+      const al = me.allianceWith(N);
+      if (al === null) {
+        if (!n.attackable) continue;
+        k++;
+        if (kinds.has("strike")) {
+          for (const f of o.probeFracs) {
+            out.push({
+              name: `strike:${n.id}:${f}`,
+              spec: {
+                directive: [this.attackStep(n.id, n.smallID, 0, f)],
+                shift: 0,
+              },
+            });
+          }
+        }
+        continue;
+      }
+      const left = al.expiresAt() - t;
+      if (kinds.has("lapse") && left + 2 <= o.probeH - 100) {
+        k++;
+        out.push({
+          name: `lapse:${n.id}:1`,
+          strikeAt: left + 2,
+          spec: {
+            directive: [
+              { delay: 0, foe: { id: n.id, until: al.expiresAt() + 900 } },
+              this.attackStep(n.id, n.smallID, left + 2, 1),
+            ],
+            shift: 0,
+          },
+        });
+      }
+      if (kinds.has("breakhalf")) {
+        out.push({
+          name: `break:${n.id}:0.5`,
+          spec: {
+            directive: [
+              {
+                delay: 0,
+                p: {
+                  intent: { type: "breakAlliance", recipient: n.id },
+                  prio: Prio.Diplomacy,
+                  cls: "diplomacy",
+                  key: `break:${n.id}`,
+                },
+              },
+              this.attackStep(n.id, n.smallID, 1, 0.5),
+            ],
+            shift: 0,
+          },
+        });
+      }
+      if (kinds.has("break")) {
+        k++;
+        out.push({
+          name: `break:${n.id}:1`,
+          spec: {
+            directive: [
+              {
+                delay: 0,
+                p: {
+                  intent: { type: "breakAlliance", recipient: n.id },
+                  prio: Prio.Diplomacy,
+                  cls: "diplomacy",
+                  key: `break:${n.id}`,
+                },
+              },
+              this.attackStep(n.id, n.smallID, 1, 1),
+            ],
+            shift: 0,
+          },
+        });
+      }
+    }
+    if (kinds.has("ally")) {
+      for (const [id] of attackers) {
+        if (!ctx.game.hasPlayer(id)) continue;
+        const N = ctx.game.player(id);
+        if (N.type() !== PlayerType.Nation || !N.isAlive()) continue;
+        if (me.isAlliedWith(N)) continue;
+        out.push({
+          name: `ally:${id}`,
+          spec: {
+            directive: [
+              {
+                delay: 0,
+                p: {
+                  intent: { type: "allianceRequest", recipient: id },
+                  prio: Prio.Recall,
+                  cls: "defense",
+                  key: `ally:${id}`,
+                },
+              },
+            ],
+            shift: 0,
+          },
+        });
+      }
+    }
+    return out.slice(0, o.probeMaxCands);
+  }
+
+  /**
+   * act3: act2 with pruning and a longer horizon for alliance breaks. Round
+   * 1 takes every candidate to probeH1; a candidate more than probePrune
+   * below the base's land there is dropped. Round 2 takes the best probeKeep
+   * non-break candidates to probeH, round 3 the best break to probeHBreak,
+   * the base to both. A candidate is judged by its value minus the base's at
+   * its own horizon; the best acts if that beats the margin.
+   */
+  private act3(ctx: AgentContext, host: ProbeHost): void {
+    const o = this.o;
+    const H = o.probeH;
+    const HB = Math.max(H, o.probeHBreak);
+    const H1 = Math.min(o.probeH1, H);
+    const at = [...new Set([...this.checkpoints(), 900, 1200, HB])]
+      .filter((h) => h <= HB)
+      .sort((a, b) => a - b);
+    const t0 = performance.now();
+    const mk = (c: Cand): Runner => {
+      const fs = performance.now();
+      const f = ctx.fork();
+      const forkMs = performance.now() - fs;
+      const pol = host.forRolloutWith(c.spec, ctx.tick);
+      return new Runner(ctx, f, pol, c.name, forkMs);
+    };
+    const base = mk({ name: "base", spec: { directive: [], shift: 0 } });
+    base.advance(H1, at);
+    const cands = this.candidates2(ctx, host, base.attackers);
+    const runners: Runner[] = [base];
+    const baseT1 = base.snaps[base.snaps.length - 1].tiles;
+    for (const c of cands) {
+      const r = mk(c);
+      r.advance(H1, at);
+      runners.push(r);
+    }
+    const lastOf = (r: Runner) => r.snaps[r.snaps.length - 1];
+    const alive1 = runners.slice(1).filter((r) => {
+      const sn = lastOf(r);
+      return sn.alive && sn.tiles >= (1 - o.probePrune) * baseT1;
+    });
+    const isBreak = (r: Runner) => r.name.startsWith("break");
+    const val = (r: Runner) => valueOf(lastOf(r), o);
+    const strikes = alive1.filter((r) => !isBreak(r)).sort((a, b) => val(b) - val(a));
+    const breaks = alive1.filter(isBreak).sort((a, b) => val(b) - val(a));
+    const keptS = strikes.slice(0, Math.max(1, o.probeKeep));
+    const keptB = breaks.slice(0, 1);
+    // The horizon each finalist is judged at: a break at HB, a lapse
+    // probeHPost ticks after its strike (at least H), anything else at H.
+    const judge = new Map<Runner, number>();
+    for (const r of keptS) {
+      const c = cands.find((x) => x.name === r.name);
+      const post =
+        o.probeHPost > 0 && c?.strikeAt !== undefined
+          ? Math.ceil((c.strikeAt + o.probeHPost) / 50) * 50
+          : H;
+      judge.set(r, Math.max(H, post));
+    }
+    for (const r of keptB) judge.set(r, HB);
+    // Base values at each horizon a finalist is judged at.
+    const baseAt = new Map<number, number>();
+    const hs = [...new Set([H, ...judge.values()])].sort((a, b) => a - b);
+    for (const h of hs) {
+      base.advance(h, at);
+      baseAt.set(h, valueOf(lastOf(base), o));
+    }
+    for (const [r, h] of judge) r.advance(h, at);
+    const snapAt = (r: Runner, h: number) => {
+      let sn = r.snaps[0];
+      for (const x of r.snaps) if (x.h <= h) sn = x;
+      return sn;
+    };
+    let best: Runner | null = null;
+    let bestGain = -Infinity;
+    const tiles = ctx.me.numTilesOwned();
+    for (const r of [...keptS, ...keptB]) {
+      const h = judge.get(r) ?? H;
+      const vb = baseAt.get(h);
+      if (vb === undefined) continue;
+      // A candidate that dies before its horizon has value -Infinity.
+      const v = r.dead ? -Infinity : valueOf(snapAt(r, h), o);
+      // Safety: no checkpoint more than probeDip below the base's land.
+      let dipped = false;
+      for (const sn of r.snaps) {
+        const b = snapAt(base, sn.h);
+        if (b.h === sn.h && sn.tiles < (1 - o.probeDip) * b.tiles) dipped = true;
+      }
+      if (dipped) continue;
+      const gain = v - vb;
+      if (gain > bestGain) {
+        bestGain = gain;
+        best = r;
+      }
+    }
+    const need = Math.max(o.probeMarginAbs, o.probeMargin * tiles);
+    let chosen = "base";
+    if (best !== null && bestGain > need) {
+      const c = cands.find((x) => x.name === best.name);
+      if (c !== undefined) {
+        host.setDirective(c.spec.directive, ctx.tick);
+        chosen = best.name;
+      }
+    }
+    const totalMs = performance.now() - t0;
+    const floors = host.floors();
+    const row = (r: Runner) => ({
+      name: r.name,
+      forkMs: Math.round(r.forkMs),
+      simMs: Math.round(r.simMs),
+      polMs: Math.round(r.polMs),
+      h: r.h,
+      j: judge.get(r) ?? null,
+      v: Math.round(val(r)),
+      atk: [...r.attackers].map(([id, x]) => [id, x.h, Math.round(x.troops)]),
+      snaps: r.snaps,
+    });
+    ctx.log(
+      `PROBE ${JSON.stringify({
+        mode: "act3",
+        t: ctx.tick,
+        nbrs: neighbours(ctx, host.wm()),
+        liveMsPerTick: this.liveMsPerTick(),
+        tiles,
+        home: Math.round(ctx.me.troops()),
+        cap: Math.round(floors.cap),
+        H: Math.round(floors.H),
+        stall: host.inStall(ctx.tick),
+        totalMs: Math.round(totalMs),
+        simTicks: runners.reduce((a, r) => a + r.h, 0),
+        chosen,
+        gain: Number.isFinite(bestGain) ? Math.round(bestGain) : null,
+        rows: runners.map(row),
+      })}`,
+    );
+    const pick = chosen === "base" ? base : (best as Runner);
+    // An act changes the future the pending checks predicted.
+    if (chosen !== "base") this.checks = this.checks.filter((c) => c.tick <= ctx.tick);
+    for (const sn of pick.snaps) {
+      this.checks.push({ tick: ctx.tick + sn.h, h: sn.h, pred: sn, t0: ctx.tick });
+    }
+  }
+
+  /**
+   * act2: successive halving. The base is rolled out probeH1 ticks first
+   * (who attacks us there picks the ally candidates), then every other
+   * candidate; the best probeKeep by value go on to probeH with the base;
+   * the best of those acts when it beats the base by probeMargin (share of
+   * our tiles) and probeMarginAbs tiles.
+   */
+  private act2(ctx: AgentContext, host: ProbeHost): void {
+    const o = this.o;
+    const H = o.probeH;
+    const H1 = Math.min(o.probeH1, H);
+    const at = this.checkpoints();
+    const t0 = performance.now();
+    const mk = (c: Cand): Runner => {
+      const fs = performance.now();
+      const f = ctx.fork();
+      const forkMs = performance.now() - fs;
+      const pol = host.forRolloutWith(c.spec, ctx.tick);
+      return new Runner(ctx, f, pol, c.name, forkMs);
+    };
+    const baseCand: Cand = { name: "base", spec: { directive: [], shift: 0 } };
+    const base = mk(baseCand);
+    base.advance(H1, at);
+    const cands = this.candidates2(ctx, host, base.attackers);
+    const runners: Runner[] = [base];
+    for (const c of cands) {
+      const r = mk(c);
+      r.advance(H1, at);
+      runners.push(r);
+    }
+    const v1 = (r: Runner) => valueOf(r.snaps[r.snaps.length - 1], o);
+    const others = runners.slice(1).sort((a, b) => v1(b) - v1(a));
+    const kept = others.slice(0, Math.max(1, o.probeKeep));
+    if (H > H1) {
+      base.advance(H, at);
+      for (const r of kept) r.advance(H, at);
+    }
+    const vb = v1(base);
+    let best: Runner | null = null;
+    for (const r of kept) if (best === null || v1(r) > v1(best)) best = r;
+    const tiles = ctx.me.numTilesOwned();
+    const need = Math.max(o.probeMarginAbs, o.probeMargin * tiles);
+    let chosen = "base";
+    if (best !== null && v1(best) > vb + need) {
+      const c = cands.find((x) => x.name === best.name);
+      if (c !== undefined) {
+        host.setDirective(c.spec.directive, ctx.tick);
+        chosen = best.name;
+      }
+    }
+    const totalMs = performance.now() - t0;
+    const floors = host.floors();
+    const row = (r: Runner) => ({
+      name: r.name,
+      forkMs: Math.round(r.forkMs),
+      simMs: Math.round(r.simMs),
+      polMs: Math.round(r.polMs),
+      h: r.h,
+      v: Math.round(v1(r)),
+      atk: [...r.attackers].map(([id, x]) => [id, x.h, Math.round(x.troops)]),
+      snaps: r.snaps,
+    });
+    ctx.log(
+      `PROBE ${JSON.stringify({
+        mode: "act2",
+        t: ctx.tick,
+        nbrs: neighbours(ctx, host.wm()),
+        liveMsPerTick: this.liveMsPerTick(),
+        tiles,
+        home: Math.round(ctx.me.troops()),
+        cap: Math.round(floors.cap),
+        H: Math.round(floors.H),
+        stall: host.inStall(ctx.tick),
+        totalMs: Math.round(totalMs),
+        simTicks: runners.reduce((a, r) => a + r.h, 0),
+        chosen,
+        rows: runners.map(row),
+      })}`,
+    );
+    const pick = chosen === "base" ? base : (best as Runner);
+    for (const sn of pick.snaps) {
+      if (sn.h > H) continue;
+      this.checks.push({ tick: ctx.tick + sn.h, h: sn.h, pred: sn, t0: ctx.tick });
+    }
+  }
+}
